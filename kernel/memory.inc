; ================================================================
; PPP OS 内存管理器 (位图)
; 管理 8 个 64KB 内存块，段地址从 0x2000 到 0x9000
; 位图：1字节，每位对应一个块 (0=空闲, 1=已占用)
; ================================================================

mem_bitmap db 0

; ----------------------------------------------------------------
; kmalloc - 分配一个空闲 64KB 内存块
; 输出: CF=0 成功, AX=分配到的段地址; CF=1 失败 (无空闲块)
; ----------------------------------------------------------------
kmalloc:
    push bx
    push cx
    
    mov cx, 8               ; 遍历所有位 (0~7)
    mov bx, 0
    
.scan:
    mov al, [cs:mem_bitmap]
    mov ah, 1
    push cx
    mov cl, bl
    shl ah, cl              ; 生成检测掩码 (例如 bl=2 -> ah=00000100b)
    pop cx
    
    test al, ah
    jz .found               ; 该位为0 -> 空闲块
    
    inc bx
    loop .scan
    
    ; 无空闲块
    pop cx
    pop bx
    stc
    ret
    
.found:
    or [cs:mem_bitmap], ah  ; 标记该块已占用
    
    ; 计算段地址: 0x2000 + 块索引 * 0x1000
    mov ax, bx
    mov dx, 0x1000
    mul dx
    add ax, 0x2000
    
    pop cx
    pop bx
    clc
    ret

; ----------------------------------------------------------------
; kfree - 释放已分配的内存块
; 输入: AX = 要释放的段地址 (如 0x3000)
; ----------------------------------------------------------------
kfree:
    pusha
    
    ; 计算块索引: (段 - 0x2000) / 0x1000
    sub ax, 0x2000
    mov dx, 0
    mov bx, 0x1000
    div bx                  ; AX = 块索引 (0~7)
    
    ; 清除对应的位
    mov cx, ax
    mov ah, 1
    shl ah, cl              ; ah = 对应位 (如 00000100b)
    not ah                  ; 取反得到清除掩码 (11111011b)
    and [cs:mem_bitmap], ah ; 清除该位
    
    popa
    ret