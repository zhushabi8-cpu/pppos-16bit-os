; ================================================================
; PPP OS 内存管理器（位图）
; 管理 8 个 64KB 内存块，段地址从 0x2000 到 0x9000
; 位图：1 字节，每位对应一个块（0=空闲，1=已占用）
; ================================================================

mem_bitmap db 0                     ; 内存块位图，初始全空闲

; ----------------------------------------------------------------
; kmalloc - 分配一个空闲 64KB 内存块
; 输出: CF=0 成功，AX=分配到的段地址；CF=1 失败（无空闲块）
; 说明: 扫描位图找到第一个空闲位，标记为已占用，返回对应的段地址
; ----------------------------------------------------------------
kmalloc:
    pushf                           ; 保存原始中断标志
    push bx
    push cx
    
    cli                             ; 关中断，保护位图操作临界区
    
    mov cx, 8                       ; 遍历 8 个块（位 0~7）
    mov bx, 0
    
.scan:
    mov al, [cs:mem_bitmap]         ; 加载当前位图
    mov ah, 1
    push cx
    mov cl, bl
    shl ah, cl                      ; 生成检测掩码（如 bl=2 -> ah=00000100b）
    pop cx
    
    test al, ah
    jz .found                       ; 该位为 0 -> 空闲块
    
    inc bx
    loop .scan
    
    ; 无空闲块
    pop cx
    pop bx
    popf                            ; 恢复中断标志
    stc                             ; 置 CF=1 失败
    ret
    
.found:
    or [cs:mem_bitmap], ah          ; 标记该块已占用
    
    ; 计算段地址：块索引 * 0x1000 + 0x2000
    mov ax, bx
    mov dx, 0x1000
    mul dx
    add ax, 0x2000                  ; AX = 段地址
    
    pop cx
    pop bx
    popf                            ; 恢复中断标志
    clc                             ; 清 CF=0 成功
    ret

; ----------------------------------------------------------------
; kfree - 释放已分配的内存块
; 输入: AX = 要释放的段地址（如 0x3000）
; 说明: 将段地址转换回块索引，清除位图中对应的位
; ----------------------------------------------------------------
kfree:
    pushf                           ; 保存原始中断标志
    pusha
    
    cli                             ; 关中断，保证位图清除原子性

    ; 计算块索引：(段地址 - 0x2000) / 0x1000
    sub ax, 0x2000
    mov dx, 0
    mov bx, 0x1000
    div bx                          ; AX = 块索引（0~7），DX=0
    
    ; 清除对应的位
    mov cx, ax
    mov ah, 1
    shl ah, cl                      ; 生成位掩码
    not ah                          ; 取反得到清除掩码
    and [cs:mem_bitmap], ah         ; 清对应位
    
.safe_exit:
    popa
    popf                            ; 恢复中断标志
    ret